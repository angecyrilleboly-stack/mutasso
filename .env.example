# ============================================================
#  MUTASSO - Fichier de configuration environnement
#  Copiez ce fichier en ".env" puis adaptez les valeurs.
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Clé Gemini (obligatoire pour les comptes rendus IA) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Base de données PostgreSQL (Supabase) — optionnel en local ---
# Sans DATABASE_URL, l'application fonctionne avec des fichiers
# locaux (data/). Renseignez ceci pour utiliser Supabase :
# Supabase > Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# --- Observabilité (optionnel) ---
# Niveau de log : trace | debug | info | warn | error (défaut : info en prod, debug en dev)
# LOG_LEVEL=info
# Sentry — monitoring des erreurs non opérationnelles (après: npm install @sentry/node)
# SENTRY_DSN=

# --- Super administrateur (accès DÉDIÉ, séparé des associations) ---
# Ces identifiants ouvrent l'espace de supervision globale.
# SUPER_ADMIN_EMAIL=superadmin@mutasso.app
# SUPER_ADMIN_MDP=
